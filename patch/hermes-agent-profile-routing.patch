-def _resolve_delegation_credentials(cfg: dict, parent_agent) -> dict:
+# Routing keys an operator-defined delegation profile may override on the
+# base delegation config. Kept to a strict allow-list so a profile can only
+# steer provider/model/endpoint auth — never unrelated delegation settings.
+_PROFILE_MERGE_KEYS = (
+    "provider",
+    "model",
+    "base_url",
+    "api_key",
+    "api_mode",
+    "command",
+    "args",
+)
+
+
+def _get_profile_config(cfg: dict, profile_name: Optional[str]) -> Optional[dict]:
+    """Look up an operator-defined delegation profile by name.
+
+    Profiles live under ``delegation.agent_profiles`` (preferred) or the
+    legacy ``delegation.agents`` key. Returns the profile dict, or ``None``
+    when the name is missing or is not a dict. Unknown names are NOT an error
+    here — the caller logs a warning and falls back to the base delegation
+    credentials, so a typo never crashes a delegation.
+    """
+    if not profile_name:
+        return None
+    profiles = cfg.get("agent_profiles") or cfg.get("agents") or {}
+    if not isinstance(profiles, dict):
+        return None
+    profile = profiles.get(str(profile_name).strip())
+    if not isinstance(profile, dict):
+        logger.warning(
+            "Unknown delegation agent profile %r; using default delegation "
+            "credentials for this subagent.",
+            profile_name,
+        )
+        return None
+    return profile
+
+
+def _merge_delegation_profile(cfg: dict, profile: dict) -> dict:
+    """Merge a named profile's routing keys over the base delegation config.
+
+    Only operator-controlled routing keys (``_PROFILE_MERGE_KEYS``) are
+    merged; a profile cleanly overrides provider/model/endpoint for the child
+    without touching the rest of the base config. The merged copy is what
+    credential resolution runs against.
+    """
+    merged = dict(cfg)
+    for key in _PROFILE_MERGE_KEYS:
+        if key in profile:
+            merged[key] = profile[key]
+    return merged
+
+
+def _resolve_delegation_credentials(
+    cfg: dict, parent_agent, profile: Optional[str] = None
+) -> dict:
     """Resolve credentials for subagent delegation.
 
     If ``delegation.base_url`` is configured, subagents use that direct
@@ -3043,13 +3141,27 @@ def _resolve_delegation_credentials(cfg: dict, parent_agent) -> dict:
     If neither base_url nor provider is configured, returns None values so the
