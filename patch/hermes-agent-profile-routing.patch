+class TestAgentProfileRouting(unittest.TestCase):
+    """Agent profile routing: per-task model selection via delegation.agent_profiles."""
+
+    def setUp(self):
+        self.parent = _make_mock_parent(depth=0)
+        self.base_cfg = {
+            "provider": "openrouter",
+            "model": "anthropic/claude-sonnet-4",
+            "base_url": "https://openrouter.ai/api/v1",
+            "api_key": "sk-or-v1-xxx",
+            "api_mode": "chat_completions",
+        }
+
+    def test_get_profile_config_returns_profile(self):
+        """_get_profile_config looks up a named profile from agent_profiles."""
+        cfg = {
+            "agent_profiles": {
+                "mira": {"provider": "openrouter", "model": "anthropic/claude-3.5-haiku"},
+            }
+        }
+        profile = _get_profile_config(cfg, "mira")
+        self.assertIsNotNone(profile)
+        self.assertEqual(profile["model"], "anthropic/claude-3.5-haiku")
+
+    def test_get_profile_config_returns_none_for_unknown(self):
+        """Unknown profile name returns None (safe fallback, never raises)."""
+        cfg = {"agent_profiles": {"mira": {"provider": "openrouter", "model": "haiku"}}}
+        self.assertIsNone(_get_profile_config(cfg, "nonexistent"))
+
+    def test_get_profile_config_returns_none_for_empty(self):
+        """Empty agent_profiles returns None."""
+        self.assertIsNone(_get_profile_config({}, "mira"))
+        self.assertIsNone(_get_profile_config({"agent_profiles": {}}, "mira"))
+
+    def test_get_profile_config_supports_legacy_agents_key(self):
+        """Legacy 'agents' key is also checked."""
+        cfg = {"agents": {"zoe": {"provider": "openai", "model": "gpt-4o"}}}
+        profile = _get_profile_config(cfg, "zoe")
+        self.assertIsNotNone(profile)
+        self.assertEqual(profile["model"], "gpt-4o")
+
+    def test_merge_delegation_profile_merges_allowed_keys(self):
+        """_merge_delegation_profile copies only _PROFILE_MERGE_KEYS."""
+        profile = {
+            "provider": "openai",
+            "model": "gpt-4o",
+            "base_url": "https://api.openai.com/v1",
+            "api_key": "sk-xxx",
+            "api_mode": "chat_completions",
+            "command": "acp",
+            "args": ["--foo"],
+            "unknown_key": "should_be_ignored",
+        }
+        merged = _merge_delegation_profile(self.base_cfg, profile)
+        self.assertEqual(merged["provider"], "openai")
+        self.assertEqual(merged["model"], "gpt-4o")
+        self.assertEqual(merged["base_url"], "https://api.openai.com/v1")
+        self.assertEqual(merged["api_key"], "sk-xxx")
+        self.assertEqual(merged["api_mode"], "chat_completions")
+        self.assertEqual(merged["command"], "acp")
+        self.assertEqual(merged["args"], ["--foo"])
+        # unknown_key must NOT be in merged
+        self.assertNotIn("unknown_key", merged)
+
+    def test_merge_delegation_profile_preserves_base_keys(self):
+        """Keys not in the profile remain from base_creds."""
+        profile = {"model": "gpt-4o-mini"}
+        merged = _merge_delegation_profile(self.base_cfg, profile)
+        self.assertEqual(merged["model"], "gpt-4o-mini")
+        self.assertEqual(merged["provider"], self.base_cfg["provider"])
+        self.assertEqual(merged["base_url"], self.base_cfg["base_url"])
+
+    def test_merge_delegation_profile_does_not_mutate_base(self):
+        """Original base_creds dict is not modified."""
+        original_model = self.base_cfg["model"]
+        _merge_delegation_profile(self.base_cfg, {"model": "gpt-4o"})
+        self.assertEqual(self.base_cfg["model"], original_model)
+
+    @patch("tools.delegate_tool._run_single_child")
+    def test_delegate_task_single_with_agent(self, mock_run):
+        """Single task mode with top-level agent parameter."""
+        mock_run.return_value = {
+            "task_index": 0, "status": "completed",
+            "summary": "Done!", "api_calls": 3, "duration_seconds": 5.0,
+        }
+
+        with patch("tools.delegate_tool._load_config") as mock_cfg:
+            mock_cfg.return_value = {
+                "agent_profiles": {
+                    "mira": {"provider": "openrouter", "model": "anthropic/claude-3.5-haiku"},
+                }
+            }
+            with patch("tools.delegate_tool._resolve_delegation_credentials") as mock_resolve:
+                mock_resolve.return_value = self.base_cfg
+                result = json.loads(delegate_task(
+                    goal="test task",
+                    agent="mira",
+                    parent_agent=self.parent,
+                ))
+                self.assertIn("results", result)
+                self.assertEqual(len(result["results"]), 1)
+                self.assertEqual(result["results"][0]["status"], "completed")
+
+    @patch("tools.delegate_tool._run_single_child")
+    def test_delegate_task_batch_with_per_task_agent(self, mock_run):
+        """Batch mode with per-task agent profiles."""
+        mock_run.side_effect = [
+            {"task_index": 0, "status": "completed", "summary": "Plan done", "api_calls": 2, "duration_seconds": 3.0},
+            {"task_index": 1, "status": "completed", "summary": "Verify done", "api_calls": 4, "duration_seconds": 6.0},
+        ]
+
+        with patch("tools.delegate_tool._load_config") as mock_cfg:
+            mock_cfg.return_value = {
+                "agent_profiles": {
+                    "mira": {"provider": "openrouter", "model": "anthropic/claude-3.5-haiku"},
+                    "zoe": {"provider": "openai", "model": "gpt-4o"},
+                }
+            }
+            with patch("tools.delegate_tool._resolve_delegation_credentials") as mock_resolve:
+                mock_resolve.return_value = self.base_cfg
+                result = json.loads(delegate_task(
+                    tasks=[
+                        {"goal": "Plan", "agent": "mira"},
+                        {"goal": "Verify", "agent": "zoe"},
+                    ],
+                    parent_agent=self.parent,
+                ))
+                self.assertIn("results", result)
+                self.assertEqual(len(result["results"]), 2)
+                self.assertEqual(result["results"][0]["summary"], "Plan done")
+                self.assertEqual(result["results"][1]["summary"], "Verify done")
+
+    def test_unknown_profile_logs_warning_and_falls_back(self):
+        """Unknown profile name logs a warning and uses base creds."""
+        cfg = {"agent_profiles": {}}
+        profile = _get_profile_config(cfg, "nonexistent")
+        self.assertIsNone(profile)
+        # base_creds unchanged
+        merged = _merge_delegation_profile(self.base_cfg, {})
+        self.assertEqual(merged["model"], self.base_cfg["model"])
+
+
+class TestDelegateSchemaProfileFields(unittest.TestCase):
+    """DELEGATE_TASK_SCHEMA must expose agent/profile but NOT provider/model."""
+
+    def test_schema_has_agent_field(self):
+        """Top-level properties include 'agent'."""
+        props = DELEGATE_TASK_SCHEMA["parameters"]["properties"]
+        self.assertIn("agent", props)
+
+    def test_schema_has_profile_field(self):
+        """Top-level properties include 'profile'."""
+        props = DELEGATE_TASK_SCHEMA["parameters"]["properties"]
+        self.assertIn("profile", props)
+
+    def test_schema_tasks_items_has_agent_and_profile(self):
+        """Per-task items include 'agent' and 'profile'."""
+        items_props = DELEGATE_TASK_SCHEMA["parameters"]["properties"]["tasks"]["items"]["properties"]
+        self.assertIn("agent", items_props)
+        self.assertIn("profile", items_props)
+
+    def test_schema_does_not_expose_provider_or_model(self):
+        """Safety: provider/model/base_url/api_key/api_mode are NOT in schema."""
+        props = DELEGATE_TASK_SCHEMA["parameters"]["properties"]
+        for forbidden in ("provider", "model", "base_url", "api_key", "api_mode"):
+            self.assertNotIn(forbidden, props, f"Schema must not expose '{forbidden}'")
+
+    def test_schema_tasks_items_does_not_expose_provider_or_model(self):
+        """Safety: per-task items also lack provider/model/base_url/api_key/api_mode."""
+        items_props = DELEGATE_TASK_SCHEMA["parameters"]["properties"]["tasks"]["items"]["properties"]
+        for forbidden in ("provider", "model", "base_url", "api_key", "api_mode"):
+            self.assertNotIn(forbidden, items_props, f"Per-task items must not expose '{forbidden}'")
+
+
 if __name__ == "__main__":
     unittest.main()
