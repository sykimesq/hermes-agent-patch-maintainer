+# ── Agent Profile Routing ─────────────────────────────────────────────────
+# Keys that an agent profile is allowed to override when routing a subagent.
+# This is the strict allow-list: only these 7 keys are merged from a profile.
+_PROFILE_MERGE_KEYS = frozenset({
+    "provider", "model", "base_url", "api_key", "api_mode", "command", "args",
+})
+
+
+def _get_profile_config(cfg: dict, profile_name: str) -> Optional[dict]:
+    """Look up an agent profile by name from delegation config.
+
+    Checks both ``delegation.agent_profiles`` and the legacy
+    ``delegation.agents`` key.  Returns None when the profile is unknown
+    (never raises — safe fallback).
+    """
+    profiles = cfg.get("agent_profiles") or cfg.get("agents") or {}
+    if not isinstance(profiles, dict):
+        return None
+    profile = profiles.get(profile_name)
+    if not isinstance(profile, dict):
+        return None
+    return profile
+
+
+def _merge_delegation_profile(base_creds: dict, profile: dict) -> dict:
+    """Merge a profile's routing keys into base credentials.
+
+    Only keys in ``_PROFILE_MERGE_KEYS`` are copied.  Unknown keys are
+    silently ignored.  The original ``base_creds`` dict is not mutated.
+    """
+    merged = dict(base_creds)
+    for key in _PROFILE_MERGE_KEYS:
+        if key in profile:
+            merged[key] = profile[key]
+    return merged
+
+
