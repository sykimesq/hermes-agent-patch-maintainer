+class TestAgentProfileRouting(unittest.TestCase):
+    """Per-task model routing via delegation.agent_profiles.
+
+    Each subagent in a delegate_task batch may be routed to a different
+    provider/model by naming an entry under delegation.agent_profiles. The
+    profile is operator-controlled (not model-facing) — the model can only
+    NAME a profile, never specify provider/model/base_url/api_key directly.
+    """
+
+    def test_get_profile_config_basic_lookup(self):
+        cfg = {"agent_profiles": {
+            "mira": {"provider": "openrouter", "model": "m1"},
+            "rumi": {"provider": "openrouter", "model": "m2"},
+        }}
+        self.assertEqual(_get_profile_config(cfg, "mira"),
+                         {"provider": "openrouter", "model": "m1"})
+        self.assertEqual(_get_profile_config(cfg, "rumi")["model"], "m2")
+
+    def test_get_profile_config_legacy_agents_key(self):
+        cfg = {"agents": {"legacy": {"provider": "p", "model": "m"}}}
+        self.assertEqual(_get_profile_config(cfg, "legacy"),
+                         {"provider": "p", "model": "m"})
+
+    def test_get_profile_config_unknown_returns_none_and_logs(self):
+        cfg = {"agent_profiles": {"mira": {"provider": "p", "model": "m"}}}
+        with self.assertLogs("tools.delegate_tool", level="WARNING") as cm:
+            self.assertIsNone(_get_profile_config(cfg, "nope"))
+        self.assertTrue(any("nope" in m for m in cm.output),
+                        f"warning must mention the unknown profile name; got {cm.output}")
+
+    def test_get_profile_config_empty_name_returns_none(self):
+        cfg = {"agent_profiles": {"mira": {"provider": "p", "model": "m"}}}
+        self.assertIsNone(_get_profile_config(cfg, ""))
+        self.assertIsNone(_get_profile_config(cfg, None))
+
+    def test_merge_profile_allowlist_strict(self):
+        base = {"provider": "bp", "model": "bm", "max_concurrent_children": 5}
+        profile = {"provider": "pp", "model": "pm", "base_url": "http://x",
+                   "unknown_key": "should_not_appear"}
+        merged = _merge_delegation_profile(base, profile)
+        self.assertEqual(merged["provider"], "pp")
+        self.assertEqual(merged["model"], "pm")
+        self.assertEqual(merged["base_url"], "http://x")
+        self.assertEqual(merged["max_concurrent_children"], 5)
+        self.assertNotIn("unknown_key", merged)
+
+    def test_profile_merge_keys_exact_set(self):
+        # Strict 7-key allow-list. Adding/removing a key here is a deliberate
+        # contract change — keep this test in sync with _PROFILE_MERGE_KEYS.
+        self.assertEqual(
+            set(_PROFILE_MERGE_KEYS),
+            {"provider", "model", "base_url", "api_key", "api_mode",
+             "command", "args"},
+        )
+
+    def test_resolve_credentials_per_profile_yields_different_models(self):
+        """Same _resolve_delegation_credentials call, different profile name
+        => different provider/model. This is the core anti-inheritance test:
+        the parent model must NOT bleed through when a profile names a
+        different provider/model."""
+        # base_url is set so the resolver bypasses resolve_runtime_provider(),
+        # which would otherwise refuse unknown providers in test environments.
+        cfg = {"agent_profiles": {
+            "mira": {"provider": "openrouter",
+                     "model": "mira-m",
+                     "base_url": "https://mira.example.com/v1"},
+            "rumi": {"provider": "openrouter",
+                     "model": "rumi-m",
+                     "base_url": "https://rumi.example.com/v1"},
+        }}
+        parent = _make_mock_parent()
+        mira = _resolve_delegation_credentials(cfg, parent, profile="mira")
+        rumi = _resolve_delegation_credentials(cfg, parent, profile="rumi")
+        self.assertEqual(mira["base_url"], "https://mira.example.com/v1")
+        self.assertEqual(mira["model"], "mira-m")
+        self.assertEqual(rumi["base_url"], "https://rumi.example.com/v1")
+        self.assertEqual(rumi["model"], "rumi-m")
+        self.assertNotEqual(mira["model"], rumi["model"],
+                            "Per-profile routing must produce different models")
+
+    def test_resolve_credentials_no_profile_uses_base(self):
+        cfg = {"provider": "openrouter", "model": "base-m",
+               "base_url": "https://base.example.com/v1",
+               "agent_profiles": {"mira": {"provider": "openrouter",
+                                           "model": "x",
+                                           "base_url": "https://x.example.com/v1"}}}
+        parent = _make_mock_parent()
+        creds = _resolve_delegation_credentials(cfg, parent, profile=None)
+        self.assertEqual(creds["model"], "base-m")
+        self.assertEqual(creds["base_url"], "https://base.example.com/v1")
+
+    def test_resolve_credentials_unknown_profile_falls_back_to_base(self):
+        cfg = {"provider": "openrouter", "model": "base-m",
+               "base_url": "https://base.example.com/v1",
+               "agent_profiles": {"mira": {"provider": "openrouter",
+                                           "model": "x",
+                                           "base_url": "https://x.example.com/v1"}}}
+        parent = _make_mock_parent()
+        with self.assertLogs("tools.delegate_tool", level="WARNING") as cm:
+            creds = _resolve_delegation_credentials(cfg, parent, profile="typo")
+        self.assertEqual(creds["model"], "base-m")
+        self.assertEqual(creds["base_url"], "https://base.example.com/v1")
+        self.assertTrue(any("typo" in m for m in cm.output))
+
+    def test_resolve_credentials_empty_config_returns_none_for_parent_inheritance(self):
+        """When neither profile nor base provider is configured, every field
+        is None — the child must inherit everything from the parent agent."""
+        parent = _make_mock_parent()
+        creds = _resolve_delegation_credentials({}, parent, profile=None)
+        for key in ("provider", "model", "base_url", "api_key", "api_mode"):
+            self.assertIsNone(creds[key],
+                              f"{key} must be None for parent inheritance")
+
+
+class TestDelegateSchemaProfileFields(unittest.TestCase):
+    """DELEGATE_TASK_SCHEMA exposes agent/profile only — never provider/model/base_url/api_key/api_mode.
+
+    The model may NAME a profile but may not specify arbitrary provider/model.
+    This is the security boundary enforced by the schema. A leak here means
+    the model can bypass operator-controlled routing.
+    """
+
+    def test_schema_top_level_has_agent_and_profile(self):
+        props = DELEGATE_TASK_SCHEMA["parameters"]["properties"]
+        self.assertIn("agent", props)
+        self.assertIn("profile", props)
+        self.assertEqual(props["agent"]["type"], "string")
+        self.assertEqual(props["profile"]["type"], "string")
+
+    def test_schema_per_task_items_have_agent_and_profile(self):
+        items = DELEGATE_TASK_SCHEMA["parameters"]["properties"]["tasks"]["items"]
+        items_props = items["properties"]
+        self.assertIn("agent", items_props)
+        self.assertIn("profile", items_props)
+
+    def test_schema_no_provider_model_or_credentials_in_per_task_items(self):
+        """per-task items MUST NOT expose provider/model/base_url/api_key/api_mode.
+        These are operator-controlled config, not model-facing knobs."""
+        items_props = DELEGATE_TASK_SCHEMA["parameters"]["properties"]["tasks"]["items"]["properties"]
+        for forbidden in ("provider", "model", "base_url", "api_key", "api_mode"):
+            self.assertNotIn(
+                forbidden, items_props,
+                f"per-task schema must not expose {forbidden!r} — "
+                f"it would let the model bypass operator-controlled routing. "
+                f"Got keys: {sorted(items_props.keys())}",
+            )
+
+
 if __name__ == "__main__":
     unittest.main()
